{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current file with Bun",
      "type": "process",
      "command": "bun",
      "args": ["run", "${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
