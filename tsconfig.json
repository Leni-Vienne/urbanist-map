{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "strictNullChecks": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@composables/*": [
                "./front/src/composables/*"
            ],
            "@components/*": [
                "./front/src/components/*"
            ],
            "@types": [
                "./front/src/types"
            ],
            "@client": [
                "./front/src/client"
            ],
        }
    }
}