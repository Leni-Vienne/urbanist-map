{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strictNullChecks": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@composables/*": [
                "./src/composables/*"
            ],
            "@components/*": [
                "./src/components/*"
            ],
            "@types": [
                "./src/types"
            ],
        }
    }
}