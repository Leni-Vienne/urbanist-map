{
  "compilerOptions": {
    "target": "esnext", // useful for this stuff : "const lastCorners = overlayObject.history.at(-1);"
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "useUnknownInCatchVariables": true,
    "noUncheckedIndexedAccess": true,
    "types": ["@types/bun"],

    "paths": {
      "@/*": ["./front/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "target": 3.5
  },
  "exclude": ["node_modules", "dist", "junk", "scripts"]
}
