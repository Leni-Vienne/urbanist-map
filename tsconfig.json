{
    "compilerOptions": {
        "target": "esnext", // useful for this stuff : "const lastCorners = overlayObject.history.at(-1);"
        "module": "ESNext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "strict": true,
        "strictNullChecks": true,
        "allowSyntheticDefaultImports": true,
        "types": [
            "@types/bun",
            "@cloudflare/workers-types" // for R2Bucket type
        ],
        "paths": {
            "@api": [
                "./front/src/types/api"
            ],
            "@tables": [
                "./back/src/db/schema"
            ],
            "@assets/*": [
                "./front/src/assets/*"
            ],
            "@composables/*": [
                "./front/src/composables/*"
            ],
            "@components/*": [
                "./front/src/components/*"
            ],
            "@constants/*": [
                "./front/src/constants/*"
            ],
            "@stores/*": [
                "./front/src/stores/*"
            ],
            "@types": [
                "./front/src/types"
            ],
            "@client": [
                "./front/src/client"
            ],
            "@pages/*": [
                "./front/src/pages/*"
            ],
            "leaflet": [
                "./node_modules/@types/leaflet"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}