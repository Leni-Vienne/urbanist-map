{
  "entry": [
    "front/src/main.{ts,js}",
    "front/src/index.html",
    "back/src/index.ts",
    "back/src/scripts/**/*",
    "package.json",
    "**/*.test.ts"
  ],
  "project": ["front/src/**/*.{ts,js,vue}", "shared/**/*.{ts,js,vue}", "back/**/*.{ts,js}"],
  "ignore": [
    "**/*.d.ts",
    "public/**/*",
    "**/scripts/**/*",
    "package.json",
    "**/osmRules.ts",
    "**/drizzle.config.ts",
    "**/db/schema.ts"
  ],
  "ignoreDependencies": ["@vitejs/plugin-vue"],
  "vite": true,
  "vue": true
}
