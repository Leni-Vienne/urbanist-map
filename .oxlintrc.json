{
  "ignorePatterns": ["**/*tests*/**"],
  // Enable all of these plugins (which are enabled by default):
  //"plugins": ["unicorn", "typescript", "oxc"],
  "categories": {
    "suspicious": "error", // mostly type assertion stuff that I don't see how to fix
    "correctness": "warn",
    "perf": "warn",
    "nursery": "warn",
    "style": "warn",
    "restriction": "warn",
    "pedantic": "off"
  },
  "rules": {
    "eslint/no-undef": "off", // warns about console, document, etc. in front-end code
    "eslint/no-await-in-loop": "off", // false positives in several places
    "eslint/func-style": ["warn", "declaration"],
    "arrow-body-style": [
      "off", //temp
      "as-needed"
    ],
    /*"unicorn/filename-case": [
      "error",
      {
        "case": "camelCase"
      }
    ],*/ // vue files are in pascal case, composables in camel case.....
    "prefer-optional-chain": "off", // makes oxlint crash
    "prefer-object-spread": "off", // conflicts with oxc "no spread in map"
    "unicorn/filename-case": "off",
    "eslint/sort-keys": "off",
    "eslint/sort-imports": "off",
    "eslint/no-ternary": "off",
    "eslint/curly": "off",
    "switch-case-braces": "off",
    "no-base-to-string": "off",
    "no-optional-chaining": "off",
    "no-console": "off",
    "no-bitwise": "off",
    "number-literal-case": "off",
    "no-inferrable-types": "off",
    "no-explicit-any": "off", // temp maybe
    "max-statements": "off", // temp maybe
    "no-undefined": "off", // temp maybe
    "no-alert": "off", // temp
    "explicit-module-boundary-types": "off", // temp
    "explicit-function-return-type": "off", // temp
    "capitalized-comments": "off", // temp
    "max-params": "off", // temp
    "no-rest-spread-properties": "off", // for older browsers
    "typescript/no-namespace": "off", // conflicts with prefer-namespace-keyword
    "no-continue": "off", // warns about early continues which is odd
    "typescript/consistent-type-definitions": "off", //temporary
    "eslint/prefer-destructuring": "off", //temporary
    "eslint/no-magic-numbers": "off", // temporary
    "unicorn/no-null": "off", // temp
    "eslint/id-length": "off", // temp
    // --------------------- restriction rules ---------------------
    "no-async-await": "off",
    "use-unknown-in-catch-callback-variable": "off" //temp?
  }
}
