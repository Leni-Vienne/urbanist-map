# AI : ============================================================================
# AI : PRODUCTION ENVIRONMENT TEMPLATE
# AI : ============================================================================
# AI : This file (.env.prod) is SAFE TO COMMIT - it only contains placeholders.
# AI : Your actual .env file with real secrets is gitignored and never committed.
# AI : 
# AI : During GitHub Actions deployment, this template is NOT used.
# AI : Instead, the workflow generates .env on the server using GitHub Secrets.
# AI : 
# AI : Purpose of this file:
# AI : 1. Documentation - Shows what variables are needed for production
# AI : 2. Local testing - Copy to .env and replace placeholders with real values
# AI : ============================================================================

# AI : Production environment configuration
COMPOSE_PROJECT_NAME=construction-map-prod
NODE_ENV=production

# AI : Database configuration
POSTGRES_DB=construction_map
POSTGRES_PASSWORD=your_production_password_here
DATABASE_URL=postgres://postgres:your_production_password_here@postgres:5432/construction_map
DB_PORT=5432

# AI : Backend port exposed to host for Caddy reverse proxy
BACKEND_PORT=3000

# AI : Alloy monitoring port
ALLOY_PORT=12345

# AI : Application URLs
CORS_ORIGIN=https://urbanistmap.org
FRONTEND_URL=https://urbanistmap.org

# AI : Backend configuration
JWT_SECRET=your_production_jwt_secret_of_at_least_32_chars
PORT=3000

# AI : Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# AI : AWS SES Email
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SES_REGION=eu-west-3
FROM_EMAIL=noreply@urbanistmap.org
ALERT_EMAIL=admin@urbanistmap.org

# AI : Cloudflare R2 Storage
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=construction-map-production

# AI : Grafana Loki logging
LOKI_URL=http://loki:3100/loki/api/v1/push

# AI : Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
