# AI : Database configuration (self-hosted PostGIS)
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/construction_map"

# AI : Backend configuration  
SESSION_ENCRYPTION_KEY="a_very_long_and_secure_session_encryption_key_of_at_least_32_chars"
JWT_SECRET="a_very_long_and_secure_jwt_secret_key_of_at_least_32_chars"
PORT=3000

# AI : Frontend configuration (for build)
VITE_API_BASE_URL="http://localhost:3000"
VITE_GOOGLE_MAPS_API_KEY=google_api_key
VITE_DEV_MODE=false

# AI : SMTP configuration for email sending (AWS SES)
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SES_REGION=us-east-1
FROM_EMAIL=noreply@yourdomain.com
