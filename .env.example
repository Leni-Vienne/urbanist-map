# Environment Configuration
# For production, use .env.prod; for preview, use .env.preview
# Deploy with: docker compose --env-file .env.prod up -d

# Project name (used for container names, volumes, networks)
# Production: construction-map-prod
# Preview: construction-map-preview
COMPOSE_PROJECT_NAME=construction-map-local

# Environment mode
NODE_ENV=development

# Database configuration (self-hosted PostGIS)
POSTGRES_DB=construction_map
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL="postgresql://postgres:your_secure_password_here@postgres:5432/construction_map"
DB_PORT=5432

# Backend port (exposed to host for Caddy)
BACKEND_PORT=3000

# Alloy monitoring port
ALLOY_PORT=12345

CORS_ORIGIN="http://localhost:5173"
# Backend configuration  
SESSION_ENCRYPTION_KEY="a_very_long_and_secure_session_encryption_key_of_at_least_32_chars"
JWT_SECRET="a_very_long_and_secure_jwt_secret_key_of_at_least_32_chars"
PORT=3000

# Frontend configuration (for build)
VITE_API_BASE_URL="http://localhost:3000"
VITE_GOOGLE_MAPS_API_KEY=google_api_key
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
NODE_ENV=production

# To debug stuff like chunk optimization in dev
VITE_DEBUG=true

# SMTP configuration for email sending
# For development with Mailpit (docker-compose.dev.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME="toReplace"
SMTP_PASSWORD="toReplace"
SMTP_SECURE=false

# For production with AWS SES
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SES_REGION=eu-west-3

FROM_EMAIL=noreply@construction-map.local
FRONTEND_URL=http://localhost:5173

# Grafana Loki endpoint for log shipping via Alloy
# For remote Loki server: https://your-loki-server.com:3100/loki/api/v1/push
# For local Loki: http://loki:3100/loki/api/v1/push
LOKI_URL=http://loki:3100/loki/api/v1/push

# Error alerting configuration
ALERT_EMAIL=admin@example.com

# For playwright stuff
TEST_USER_EMAIL=email@domain.com
TEST_USER_PASSWORD=your_admin_password

# Optional: Admin credentials for admin-specific tests
TEST_ADMIN_EMAIL=email@domain.com
TEST_ADMIN_PASSWORD=your_admin_password

TEST_BASE_URL=http://localhost:5173
TEST_BACKEND_URL=http://localhost:3000

# Cloudflare R2 storage configuration (for production)
# Images are stored locally until moderator approval, then automatically migrated to R2
# Leave blank to keep all images in local storage (works fine for small/medium deployments)
# Get R2 credentials from Cloudflare dashboard: R2 > Manage R2 API Tokens
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=construction-map-images

# Deployment Configuration (GitHub Secrets)
# These are used by the GitHub Actions workflow, not by the application.
# You should set these as Secrets in your GitHub Repository settings.
REMOTE_HOST=your.server.ip
REMOTE_PORT=22 (Default: 22, change if using custom SSH port)
REMOTE_USER=your_ssh_username
REMOTE_PASSWORD=your_ssh_password