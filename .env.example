# Local development environment

COMPOSE_PROJECT_NAME=construction-map-local
NODE_ENV=development

POSTGRES_DB=construction_map
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgres://postgres:your_password_here@postgres:5432/construction_map
DB_PORT=5432

BACKEND_PORT=3000

ALLOY_PORT=12345

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

COOKIE_SECRET=your_cookie_secret_of_at_least_32_chars
PORT=3000

VITE_API_BASE_URL=http://localhost:3000
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here # or use openstreetmap tiles
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_DEBUG=true #useful for local dev, used to see what chunks are loaded

SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SES_REGION=eu-west-3
FROM_EMAIL=noreply@construction-map.local
ALERT_EMAIL=admin@example.com

R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=construction-map-local

LOKI_URL=http://loki:3100/loki/api/v1/push

TURNSTILE_SECRET_KEY=your_turnstile_secret_key

TEST_USER_EMAIL=your_test_user_email
TEST_USER_PASSWORD=your_test_user_password
TEST_ADMIN_EMAIL=your_test_admin_email
TEST_ADMIN_PASSWORD=your_test_admin_password
TEST_BASE_URL=http://localhost:5173
TEST_BACKEND_URL=http://localhost:3000
