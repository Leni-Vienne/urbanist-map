# AI : ============================================================================
# AI : PREVIEW ENVIRONMENT TEMPLATE
# AI : ============================================================================
# AI : This file (.env.preview) is SAFE TO COMMIT - it only contains placeholders.
# AI : Your actual .env file with real secrets is gitignored and never committed.
# AI : 
# AI : During GitHub Actions deployment, this template is NOT used.
# AI : Instead, the workflow generates .env on the server using GitHub Secrets.
# AI : 
# AI : Purpose of this file:
# AI : 1. Documentation - Shows what variables are needed for preview
# AI : 2. Local testing - Copy to .env and replace placeholders with real values
# AI : ============================================================================

# AI : Preview environment configuration
COMPOSE_PROJECT_NAME=construction-map-preview
NODE_ENV=preview

# AI : Database configuration (separate from production)
POSTGRES_DB=construction_map_preview
POSTGRES_PASSWORD=your_preview_password_here
DATABASE_URL=postgres://postgres:your_preview_password_here@postgres:5432/construction_map_preview
DB_PORT=5433

# AI : Backend port exposed to host for Caddy reverse proxy (different from prod)
BACKEND_PORT=3001

# AI : Alloy monitoring port (different from prod)
ALLOY_PORT=12346

# AI : Application URLs
CORS_ORIGIN=https://preview.construction-map-preview.pages.dev
FRONTEND_URL=https://preview.construction-map-preview.pages.dev

# AI : Backend configuration
JWT_SECRET=your_preview_jwt_secret_of_at_least_32_chars
PORT=3000

# AI : Google OAuth (can reuse production client ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# AI : AWS SES Email (can reuse production credentials)
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SES_REGION=eu-west-3
FROM_EMAIL=noreply@constructionmap.org
ALERT_EMAIL=admin@constructionmap.org

# AI : Cloudflare R2 Storage (SEPARATE bucket for preview)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=construction-map-preview

# AI : Grafana Loki logging (can reuse production Loki)
LOKI_URL=http://loki:3100/loki/api/v1/push

# AI : Cloudflare Turnstile (can reuse production key)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
