# Preview environment

COMPOSE_PROJECT_NAME=construction-map-preview
NODE_ENV=preview

POSTGRES_DB=construction_map_preview
POSTGRES_PASSWORD=your_preview_password_here
DATABASE_URL=postgres://postgres:your_preview_password_here@postgres:5432/construction_map_preview
DB_PORT=5433

BACKEND_PORT=3001

ALLOY_PORT=12346

CORS_ORIGIN=https://preview.construction-map-preview.pages.dev
FRONTEND_URL=https://preview.construction-map-preview.pages.dev

COOKIE_SECRET=your_preview_cookie_secret_of_at_least_32_chars
PORT=3000

VITE_API_BASE_URL=preview-api.urbanistmap.org
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here # or use openstreetmap tiles
VITE_GOOGLE_CLIENT_ID=your_google_client_id

SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SES_REGION=eu-west-3
FROM_EMAIL=noreply@urbanistmap.org
ALERT_EMAIL=admin@urbanistmap.org

R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=construction-map-preview

LOKI_URL=http://loki:3100/loki/api/v1/push

TURNSTILE_SECRET_KEY=your_turnstile_secret_key
