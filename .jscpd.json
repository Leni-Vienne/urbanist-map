{
  "threshold": 1,
  "min-lines": 3,
  "ignore": [
    "grafana.yml",
    "grafana-osm.yml",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/.nuxt/**",
    "**/coverage/**",
    "**/drizzle/**",
    "*.md",
    "**/playwright-report/**",
    "**/report/**"
  ],
  "reporters": ["console"],
  "absolute": true
}
