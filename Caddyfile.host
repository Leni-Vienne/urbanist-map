# Host-level Caddyfile for routing both production and preview environments
# This file should be deployed to /etc/caddy/Caddyfile on the server

# Production API
api.urbanistmap.org {
    reverse_proxy localhost:3000 {
        health_uri /api/health
        health_interval 30s
        health_timeout 10s
    }
    
    encode zstd gzip
    
    log {
        output stdout
        format console
    }
}

# Preview API
preview-api.urbanistmap.org {
    reverse_proxy localhost:3001 {
        health_uri /api/health
        health_interval 30s
        health_timeout 10s
    }
    
    encode zstd gzip
    
    log {
        output stdout
        format console
    }
}
