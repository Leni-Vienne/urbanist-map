{
  "type": "module",
  "scripts": {
    "preview": "vite preview front",
    "dev-front": "vite front",
    "build-front-workflow": "vite build front --mode=production",
    "build-front": "vite build front --mode=production",
    "dev-back": "bun --hot back/src/index.ts",
    "build-back": "bun build back/src/index.ts --target=bun --outfile=./server.bundle.js",
    "start-back": "bun ./server.bundle.js",
    "db:generate": "cd back && bun --env-file=../.env --bun run drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "cd back && bun --env-file=../.env --bun run drizzle-kit push --config=drizzle.config.ts",
    "db:migrate": "cd back && bun --env-file=../.env --bun run drizzle-kit migrate --config=drizzle.config.ts",
    "boundaries:import": "bun ./back/src/scripts/import-boundaries.ts ./scripts/osm-extract/planet-latest_boundaries.geojsonl",
    "osm:import": "bun ./back/src/scripts/import-osm.ts",
    "osm:stats": "bun ./back/src/scripts/stats-osm.ts",
    "osm:geojson": "bun ./back/src/scripts/stats-osm-geojson.ts",
    "migrate:r2-thumbnails": "cd back && bun --env-file=../.env run src/scripts/generate-r2-thumbnails.ts",
    "cleanup:images": "cd back && bun --env-file=../.env run src/scripts/cleanup-images.ts",
    "unused-translations": "bun run scripts/find-unused-translations.ts",
    "typecheck": "bunx vue-tsc --noEmit",
    "jscpd": "bunx jscpd .",
    "oxfmt": "bunx oxfmt",
    "lint": "bunx oxlint --type-aware --format=stylish && bunx vue-tsc --noEmit",
    "deps:analyze": "madge front/src > .bundle-report/deps-analysis.txt",
    "deps:circular": "madge --circular --warning front/src",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@lucide/vue": "^1.28.0",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "drizzle-orm": "v1.0.0-rc.4",
    "google-auth-library": "^10.9.1",
    "hono": "^4.12.33",
    "hono-sessions": "^0.8.1",
    "maplibre-gl": "^6.1.0",
    "nodemailer": "^9.0.3",
    "pinia": "^4.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "terra-draw": "^1.32.2",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "uuid": "^14.0.1",
    "vite": "^8.2.0",
    "vite-plugin-qrcode": "^0.4.1",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3",
    "zod-geojson": "^1.7.0"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.5",
    "@types/bun": "^1.3.14",
    "@types/geojson": "^7946.0.16",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "drizzle-kit": "v1.0.0-rc.4",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rollup-plugin-visualizer": "^7.0.1",
    "ts-morph": "^28.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*": "bunx oxfmt --no-error-on-unmatched-pattern"
  }
}
