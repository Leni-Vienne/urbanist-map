    "@types/express-session": "^1.18.2",
    "@types/leaflet": "^1.9.19",
    "@vitejs/plugin-vue": "^6.0.0",
    "drizzle-kit": "^0.31.4",
    "oxlint": "^1.3.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^7.7.7"
  }
