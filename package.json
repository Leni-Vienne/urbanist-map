{
  "type": "module",
  "scripts": {
    "preview": "vite preview front",
    "dev-front": "vite front",
    "build-front-workflow": "vite build front --mode=production",
    "build-front": "vite build front --mode=production",
    "dev-back": "bun --hot back/src/index.ts",
    "build-back": "bun build back/src/index.ts --target=bun --outfile=./server.bundle.js",
    "start-back": "bun ./server.bundle.js",
    "db:generate": "cd back && bun --env-file=../.env --bun ../node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.ts",
    "db:push": "cd back && bun --env-file=../.env --bun ../node_modules/drizzle-kit/bin.cjs push --config=drizzle.config.ts",
    "db:migrate": "cd back && bun --env-file=../.env --bun ../node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts",
    "boundaries:import": "bun ./back/src/scripts/import-boundaries.ts ./scripts/osm-extract/planet-latest_boundaries.geojsonl",
    "osm:import": "bun ./back/src/scripts/import-osm.ts",
    "osm:stats": "bun ./back/src/scripts/stats-osm.ts",
    "osm:stats-geojson": "bun ./back/src/scripts/stats-osm-geojson.ts",
    "migrate:r2-thumbnails": "cd back && bun --env-file=../.env run src/scripts/generate-r2-thumbnails.ts",
    "unused-translations": "bun run scripts/find-unused-translations.ts",
    "typecheck": "vue-tsc --noEmit",
    "jscpd": "bunx jscpd .",
    "oxfmt": "bunx oxfmt",
    "lint": "bunx oxlint --type-aware --format=stylish && bun run typecheck",
    "deps:analyze": "madge front/src > .bundle-report/deps-analysis.txt",
    "deps:circular": "madge --circular --warning front/src",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@lucide/vue": "^1.63.0",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "1.0.0-rc.5",
    "google-auth-library": "^11.3.1",
    "hono": "^4.13.14",
    "hono-sessions": "^0.8.1",
    "isbot": "^5.2.2",
    "maplibre-gl": "^6.16.0",
    "nodemailer": "^10.2.1",
    "pinia": "^4.1.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "terra-draw": "^1.39.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "vite": "^8.3.5",
    "vite-plugin-qrcode": "^0.4.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7",
    "zod-geojson": "^1.7.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.90.0",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@scayle/eslint-plugin-vue-composable": "^1.2.1",
    "@types/bun": "^1.4.4",
    "@types/geojson": "^7946.0.16",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint-plugin-harlanzw": "^0.23.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rollup-plugin-visualizer": "^7.1.1",
    "ts-morph": "^28.0.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "unplugin-vue-components": "^32.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "3.3.13",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*": "bunx oxfmt --no-error-on-unmatched-pattern"
  }
}
