{
  "type": "module",
  "scripts": {
    "unused": "bunx nyc report --reporter=html --reporter=text --report-dir=coverage",
    "ts-check": "bunx vue-tsc@latest --noEmit",
    "oxlint": "bunx oxlint@latest",
    "tsgolint": "bunx oxlint-tsgolint",
    "preview": "vite preview front",
    "dev-front": "bunx --bun vite front",
    "build-front-workflow": "bun --bun vite build front --mode=production",
    "build-front": "vite build front --mode=production",
    "dev-back": "bun --hot back/src/index.ts",
    "build-back": "bun build back/src/index.ts --target=bun --outfile=./server.bundle.js --external sharp",
    "start-back": "bun ./server.bundle.js",
    "db:generate": "cd back && bun --env-file=../.env --bun run drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "cd back && bun --env-file=../.env --bun run drizzle-kit push --config=drizzle.config.ts",
    "db:migrate": "cd back && bun --env-file=../.env --bun run drizzle-kit migrate --config=drizzle.config.ts",
    "db:drop": "cd back && bun run drizzle-kit drop",
    "import:cities": "cd back && bun run src/scripts/import-cities.ts",
    "deps:analyze": "madge --json front/src > deps-analysis.json",
    "deps:circular": "madge --circular --warning front/src",
    "test": "bun run test:back && bun run test:front",
    "test:back": "cd back && bun --env-file=../.env.test test --timeout 30000",
    "test:front": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:playwright": "playwright test"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@primeuix/themes": "^1.2.5",
    "@tailwindcss/vite": "^4.1.14",
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "drizzle-orm": "^0.44.6",
    "google-auth-library": "^10.4.0",
    "hono": "^4.9.12",
    "hono-sessions": "^0.8.0",
    "leaflet-distortableimage": "Leni-vienne/Leaflet.DistortableImage",
    "leaflet-doubletapdrag": "^0.1.2",
    "leaflet-doubletapdragzoom": "^0.3.2",
    "leaflet-toolbar": "^0.4.0-alpha.2",
    "nodemailer": "^7.0.9",
    "pinia": "^3.0.3",
    "postgres": "^3.4.7",
    "primeicons": "^7.0.0",
    "primevue": "^4.4.1",
    "rolldown-vite": "^7.1.17",
    "sharp": "^0.34.4",
    "superjson": "^2.2.2",
    "tailwindcss": "^4.1.14",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251011.0",
    "@playwright/test": "^1.56.0",
    "@primevue/auto-import-resolver": "^4.4.1",
    "@types/bun": "^1.3.0",
    "@types/cors": "^2.8.19",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^7.0.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "istanbul-lib-coverage": "^3.2.2",
    "jsdom": "^27.0.0",
    "madge": "^8.0.0",
    "oxlint": "^1.23.0",
    "oxlint-tsgolint": "^0.2.0",
    "rollup-plugin-visualizer": "^6.0.4",
    "unplugin-vue-components": "^29.1.0",
    "vite-plugin-istanbul": "^7.2.0",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vitest": "^3.2.4"
  }
}