{
  "type": "module",
  "scripts": {
    "preview": "vite preview front",
    "dev-front": "bunx --bun vite front",
    "build-front-workflow": "bun --bun vite build front --mode=production",
    "build-front": "vite build front --mode=production",
    "dev-back": "bun --hot back/src/index.ts",
    "build-back": "bun build back/src/index.ts --target=bun --outfile=./server.bundle.js --external sharp",
    "start-back": "bun ./server.bundle.js",
    "db:generate": "cd back && bun --env-file=../.env --bun run drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "cd back && bun --env-file=../.env --bun run drizzle-kit push --config=drizzle.config.ts",
    "db:migrate": "cd back && bun --env-file=../.env --bun run drizzle-kit migrate --config=drizzle.config.ts",
    "db:drop": "cd back && bun run drizzle-kit drop",
    "db:studio": "cd back && bun --env-file=../.env --bun run drizzle-kit studio --config=drizzle.config.ts",
    "db:fill": "bun ./back/src/scripts/import-geonames.ts",
    "migrate:r2-thumbnails": "cd back && bun --env-file=../.env run src/scripts/generate-r2-thumbnails.ts",
    "cleanup:images": "cd back && bun --env-file=../.env run src/scripts/cleanup-images.ts",
    "unused-translations": "bun run scripts/find-unused-translations.ts",
    "typecheck": "bunx vue-tsc --noEmit",
    "jscpd": "bunx jscpd .",
    "oxfmt": "bunx oxfmt",
    "lint": "bunx oxlint --type-check",
    "lint2": "bunx oxlint --type-aware",
    "deps:analyze": "madge --json front/src > deps-analysis.json",
    "deps:circular": "madge --circular --warning front/src",
    "deps:orphans": "madge --orphans front/src",
    "test": "bun run test:back && bun run test:front",
    "test:back": "cd back && bun --env-file=../.env.test test --timeout 30000",
    "test:front": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:playwright": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.19.2",
    "@hono/trpc-server": "^0.4.2",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.2.1",
    "@trpc/client": "^11.12.0",
    "@trpc/server": "^11.12.0",
    "drizzle-orm": "^0.45.1",
    "google-auth-library": "^10.6.1",
    "hono": "^4.12.7",
    "hono-sessions": "^0.8.1",
    "leaflet-distortableimage": "Leni-vienne/Leaflet.DistortableImage",
    "leaflet-toolbar": "git+https://github.com/Leni-Vienne/Leaflet.toolbar.git",
    "nodemailer": "^8.0.2",
    "pinia": "^3.0.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "sharp": "^0.34.5",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.2.1",
    "tailwindcss-primeui": "^0.6.1",
    "uuid": "^13.0.0",
    "vite": "8.0.0-beta.18",
    "vite-plugin-qrcode": "^0.3.0",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3",
    "zod": "^4.3.6",
    "zod-geojson": "^1.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260310.1",
    "@playwright/test": "^1.58.2",
    "@primevue/auto-import-resolver": "^4.5.4",
    "@types/bun": "^1.3.10",
    "@types/cors": "^2.8.19",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^7.0.11",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.3",
    "madge": "^8.0.0",
    "oxfmt": "^0.38.0",
    "oxlint": "^1.53.0",
    "oxlint-tsgolint": "^0.16.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "unplugin-vue-components": "^31.0.0",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "leaflet-toolbar": "github:Leni-vienne/Leaflet.toolbar"
  },
  "lint-staged": {
    "*": "bunx oxfmt --no-error-on-unmatched-pattern"
  }
}
