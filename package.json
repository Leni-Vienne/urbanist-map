{
  "type": "module",
  "scripts": {
    "preview": "vite preview front",
    "dev-front": "vite front",
    "build-front": "vite build front",
    "dev-back": "bun --hot back/src/index.ts",
    "build-back": "bun build server/index.ts --target=bun --outfile=./server/server.bundle.js",
    "db:generate": "cd back && bun run drizzle-kit generate",
    "db:push": "cd back && bun run drizzle-kit push",
    "db:migrate": "cd back && bun run drizzle-kit migrate",
    "import:cities": "cd back && bun run src/scripts/import-cities.ts"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@primeuix/themes": "^1.1.2",
    "@tailwindcss/vite": "^4.1.11",
    "@trpc/client": "^11.4.3",
    "@trpc/server": "^11.4.3",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.3",
    "hono-sessions": "^0.7.3",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "leaflet-distortableimage": "Karelics/Leaflet.DistortableImage",
    "leaflet-toolbar": "^0.4.0-alpha.2",
    "pg": "^8.16.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.5",
    "superjson": "^2.2.2",
    "tailwindcss": "^4.1.11",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
