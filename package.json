{
  "type": "module",
  "scripts": {
    "preview": "vite preview front",
    "dev-front": "vite front",
    "build-front-workflow": "vite build front --mode=production",
    "build-front": "vite build front --mode=production",
    "dev-back": "bun --hot back/src/index.ts",
    "build-back": "bun build back/src/index.ts --target=bun --outfile=./server.bundle.js",
    "start-back": "bun ./server.bundle.js",
    "db:generate": "cd back && bun --env-file=../.env --bun run drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "cd back && bun --env-file=../.env --bun run drizzle-kit push --config=drizzle.config.ts",
    "db:migrate": "cd back && bun --env-file=../.env --bun run drizzle-kit migrate --config=drizzle.config.ts",
    "db:drop": "cd back && bun run drizzle-kit drop",
    "db:studio": "cd back && bun --env-file=../.env --bun run drizzle-kit studio --config=drizzle.config.ts",
    "db:fill": "bun ./back/src/scripts/import-geonames.ts",
    "migrate:r2-thumbnails": "cd back && bun --env-file=../.env run src/scripts/generate-r2-thumbnails.ts",
    "cleanup:images": "cd back && bun --env-file=../.env run src/scripts/cleanup-images.ts",
    "unused-translations": "bun run scripts/find-unused-translations.ts",
    "typecheck": "bunx vue-tsc --noEmit",
    "jscpd": "bunx jscpd .",
    "oxfmt": "bunx oxfmt",
    "lint": "bunx oxlint --type-check --type-aware --format=stylish",
    "lint2": "bunx oxlint --type-aware --format=stylish",
    "deps:analyze": "madge --json front/src > deps-analysis.json",
    "deps:circular": "madge --circular --warning front/src",
    "deps:orphans": "madge --orphans front/src",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.3.0",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.6.2",
    "hono": "^4.12.23",
    "hono-sessions": "^0.8.1",
    "maplibre-gl": "^5.24.0",
    "nodemailer": "^8.0.10",
    "pinia": "^3.0.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.3.0",
    "tailwindcss-primeui": "^0.6.1",
    "terra-draw": "^1.31.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "uuid": "^14.0.0",
    "vite": "^8.0.16",
    "vite-plugin-qrcode": "^0.4.1",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3",
    "zod-geojson": "^1.6.5"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.5",
    "@types/bun": "^1.3.14",
    "@types/geojson": "^7946.0.16",
    "@types/nodemailer": "^8.0.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jscpd": "^4.2.4",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "madge": "^8.0.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "ts-morph": "^28.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite-plugin-vue-devtools": "^8.1.2"
  },
  "lint-staged": {
    "*": "bunx oxfmt --no-error-on-unmatched-pattern"
  }
}
