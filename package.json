{
  "type": "module",
  "scripts": {
    "preview": "vite preview front",
    "dev-front": "bunx --bun vite front",
    "build-front": "vite build front",
    "dev-back": "bun --hot back/src/index.ts",
    "build-back": "bun build back/src/index.ts --target=bun --outfile=./server.bundle.js",
    "start-back": "bun ./server.bundle.js",
    "dev-worker": "wrangler dev worker/index.ts --compatibility-date=2024-01-15",
    "deploy-worker": "wrangler deploy",
    "deploy-pages": "wrangler pages deploy front/dist",
    "deploy": "bun run build-front && bun run deploy-pages && bun run deploy-worker",
    "db:generate": "cd back && bun run drizzle-kit generate",
    "db:push": "cd back && bun run drizzle-kit push",
    "db:migrate": "cd back && bun run drizzle-kit migrate",
    "db:drop": "cd back && bun run drizzle-kit drop",
    "import:cities": "cd back && bun run src/scripts/import-cities.ts"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@primeuix/themes": "^1.2.1",
    "@supabase/supabase-js": "^2.52.1",
    "@tailwindcss/vite": "^4.1.11",
    "@trpc/client": "^11.4.3",
    "@trpc/server": "^11.4.3",
    "@vectorial1024/leaflet-color-markers": "^2.0.4",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.2",
    "hono": "^4.8.4",
    "hono-sessions": "^0.8.0",
    "leaflet": "^1.9.4",
    "leaflet-distortableimage": "Karelics/Leaflet.DistortableImage",
    "leaflet-toolbar": "^0.4.0-alpha.2",
    "leaflet.gridlayer.googlemutant": "^0.15.0",
    "pg": "^8.16.3",
    "pinia": "^3.0.3",
    "postgres": "^3.4.7",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.6",
    "superjson": "^2.2.2",
    "tailwindcss": "^4.1.11",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.3.6",
    "@types/bun": "^1.2.18",
    "@types/cors": "^2.8.19",
    "@types/express-session": "^1.18.2",
    "@types/leaflet": "^1.9.20",
    "@vitejs/plugin-vue": "^6.0.0",
    "drizzle-kit": "^0.31.4",
    "oxlint": "^1.6.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^7.0.4",
    "vite-plugin-vue-devtools": "^7.7.7",
    "wrangler": "^4.26.0"
  }
}