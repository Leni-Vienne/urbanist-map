{
  "type": "module",
  "scripts": {
    "preview": "vite preview front",
    "dev-front": "bunx --bun vite front",
    "build-front-workflow": "bun --bun vite build front --mode=production",
    "build-front": "vite build front --mode=production",
    "dev-back": "bun --hot back/src/index.ts",
    "build-back": "bun build back/src/index.ts --target=bun --outfile=./server.bundle.js --external sharp",
    "start-back": "bun ./server.bundle.js",
    "db:generate": "cd back && bun --env-file=../.env --bun run drizzle-kit generate --config=drizzle.config.ts",
    "db:push": "cd back && bun --env-file=../.env --bun run drizzle-kit push --config=drizzle.config.ts",
    "db:migrate": "cd back && bun --env-file=../.env --bun run drizzle-kit migrate --config=drizzle.config.ts",
    "db:drop": "cd back && bun run drizzle-kit drop",
    "db:studio": "cd back && bun --env-file=../.env --bun run drizzle-kit studio --config=drizzle.config.ts",
    "import:cities": "cd back && bun run src/scripts/import-cities.ts",
    "migrate:r2-thumbnails": "cd back && bun --env-file=../.env run src/scripts/generate-r2-thumbnails.ts",
    "cleanup:images": "cd back && bun --env-file=../.env run src/scripts/cleanup-images.ts",
    "unused-export": "python scripts/find-truly-unused.py",
    "typecheck": "bunx vue-tsc --noEmit",
    "jscpd": "bunx jscpd .",
    "oxfmt": "bunx oxfmt",
    "oxlint": "bunx oxlint --type-aware",
    "deps:analyze": "madge --json front/src > deps-analysis.json",
    "deps:circular": "madge --circular --warning front/src",
    "test": "bun run test:back && bun run test:front",
    "test:back": "cd back && bun --env-file=../.env.test test --timeout 30000",
    "test:front": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:playwright": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.1",
    "@primeuix/themes": "^2.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@trpc/client": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "drizzle-orm": "^0.45.1",
    "google-auth-library": "^10.5.0",
    "hono": "^4.11.1",
    "hono-sessions": "^0.8.0",
    "leaflet-distortableimage": "Leni-vienne/Leaflet.DistortableImage",
    "leaflet-toolbar": "^0.4.0-alpha.2",
    "nodemailer": "^7.0.11",
    "pinia": "^3.0.4",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.7",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "sharp": "^0.34.5",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.1.18",
    "tailwindcss-primeui": "^0.6.1",
    "uuid": "^13.0.0",
    "vite": "8.0.0-beta.2",
    "vite-plugin-qrcode": "^0.3.0",
    "vue": "^3.5.26",
    "vue-i18n": "^11.2.7",
    "vue-router": "^4.6.4",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251221.0",
    "@playwright/test": "^1.57.0",
    "@primevue/auto-import-resolver": "^4.5.4",
    "@types/bun": "^1.3.5",
    "@types/cors": "^2.8.19",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^7.0.4",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "ts-prune": "^0.10.3",
    "unplugin-vue-components": "^30.0.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*": "bunx oxfmt --no-error-on-unmatched-pattern"
  }
}
