// AI : Grafana Alloy configuration for log shipping
// AI : This captures Docker container logs and pushes them to Grafana Loki

// AI : Discover Docker containers and scrape their logs
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  
  // AI : Only scrape the backend container logs
  filter {
    name   = "name"
    values = ["construction-map-backend"]
  }
}

// AI : Scrape logs from discovered containers
loki.source.docker "backend_logs" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.containers.targets
  forward_to       = [loki.write.default.receiver]
  relabel_rules    = loki.relabel.backend.rules
  
  // AI : Keep JSON formatting from pino
  json_pipeline_stages = [
    {
      json = {
        expressions = {
          level  = "level"
          time   = "time"
          msg    = "msg"
          method = "method"
          path   = "path"
          status = "status"
        }
      }
    },
  ]
}

// AI : Add labels to logs for better filtering in Grafana
loki.relabel "backend" {
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
  
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  
  forward_to = []
}

// AI : Push logs to Loki
loki.write "default" {
  endpoint {
    url = env("LOKI_URL")
    
    // AI : Add basic auth if needed (optional)
    // basic_auth {
    //   username = env("LOKI_USERNAME")
    //   password = env("LOKI_PASSWORD")
    // }
  }
}
