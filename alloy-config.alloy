// Grafana Alloy configuration for log shipping
// This captures Docker container logs and pushes them to Grafana Loki

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  
  // Scrape backend container logs (matches both prod and preview environments)
  filter {
    name   = "name"
    values = [env("COMPOSE_PROJECT_NAME") + "-backend"]
  }
}

loki.source.docker "backend_logs" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.containers.targets
  forward_to       = [loki.process.json.receiver]
  relabel_rules    = loki.relabel.backend.rules
}

loki.process "json" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level     = "level",
      time      = "time",
      msg       = "msg",
      method    = "method",
      path      = "path",
      status    = "status",
      cfCountry = "cfCountry",
      botClass  = "botClass",
      botKind   = "botKind",
    }
  }

  // cfCountry is a stream label so LogQL can filter on it without parsing every line, and so the
  // counters below carry it. Cloudflare emits a two-letter code (plus XX for unknown and T1 for
  // Tor), which keeps this bounded at a few hundred streams. Never promote ip or path: both are
  // unbounded and would wreck the index.
  //
  // botClass is the request-time verdict from back/src/services/botClassifier.ts: 5 fixed values
  // (official-range, scanner, declared-bot, human-likely, unknown). botKind collapses those to
  // bot/human/unknown for the stacked bot-vs-human panel. Because botKind is determined by
  // botClass, it creates no stream beyond the ones botClass already creates, so the convenience is
  // free at the index. botOperator is NOT promoted: for declared bots it comes from the
  // User-Agent, so a client picks its value and the cardinality is unbounded. Read it with | json.
  //
  // Only requests through the middleware carry these, which is what excludes health checks from
  // every panel: /api/health is served before requestLogger and logs no verdict, so a
  // botKind != "" filter drops it without a path match.
  stage.labels {
    values = {
      level     = "",
      cfCountry = "",
      botClass  = "",
      botKind   = "",
    }
  }

  // Health checks reach the container directly rather than through Cloudflare, so they carry no
  // client IP and no country. They outnumber real traffic several times over and are excluded from
  // the counter only, not from Loki.
  stage.match {
    selector = "{service=\"backend\"} != \"/api/health\""

    // Aggregate counters exposed on Alloy's own /metrics endpoint. They hold no IP and no
    // identifier, so they are anonymous data rather than personal data.
    stage.metrics {
      metric.counter {
        name        = "requests_total"
        description = "Backend requests, labelled by the stream's cfCountry, level, botClass and botKind"
        source      = "status"
        action      = "inc"
        // Countries appear sparsely at this traffic level, so keep series alive well past the
        // default 5m to stop them dropping out between requests.
        max_idle_duration = "24h"
      }
    }
  }
}

loki.relabel "backend" {
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
  
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  
  forward_to = []
}

loki.write "default" {
  endpoint {
    url = env("GCLOUD_HOSTED_LOGS_URL")
    basic_auth {
      username = env("GCLOUD_HOSTED_LOGS_ID")
      password = env("GCLOUD_RW_API_KEY")
    }
  }
}
