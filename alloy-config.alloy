// Grafana Alloy configuration for log shipping
// This captures Docker container logs and pushes them to Grafana Loki

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  
  // Scrape backend container logs (matches both prod and preview environments)
  filter {
    name   = "name"
    values = [env("COMPOSE_PROJECT_NAME") + "-backend"]
  }
}

loki.source.docker "backend_logs" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.containers.targets
  forward_to       = [loki.process.json.receiver]
  relabel_rules    = loki.relabel.backend.rules
}

loki.process "json" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level     = "level",
      time      = "time",
      msg       = "msg",
      method    = "method",
      path      = "path",
      status    = "status",
      cfCountry = "cfCountry",
      botClass  = "botClass",
      botKind   = "botKind",
    }
  }

  // cfCountry is a stream label so LogQL can filter on it without parsing every line. Cloudflare
  // emits a two-letter code (plus XX for unknown and T1 for Tor), which keeps this bounded at a few
  // hundred streams. Never promote ip or path: both are unbounded and would wreck the index.
  //
  // botClass is the request-time verdict from back/src/services/botClassifier.ts: 5 fixed values
  // (official-range, scanner, declared-bot, human-likely, unknown). botKind collapses those to
  // bot/human/unknown for the stacked bot-vs-human panel. Because botKind is determined by
  // botClass, it creates no stream beyond the ones botClass already creates, so the convenience is
  // free at the index. botOperator and visitorId are NOT promoted. For declared bots, botOperator
  // comes from the User-Agent, so a client picks its value and the cardinality is unbounded.
  // visitorId is a keyed, anonymous identifier for a single client IP in unique-visitor queries.
  // Read both fields with | json.
  //
  // Only requests through the middleware carry these, which is what excludes health checks from
  // every panel: /api/health is served before requestLogger and logs no verdict, so a
  // botKind != "" filter drops it without a path match.
  stage.labels {
    values = {
      level     = "",
      cfCountry = "",
      botClass  = "",
      botKind   = "",
    }
  }

}

loki.relabel "backend" {
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
  
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  
  forward_to = []
}

loki.write "default" {
  endpoint {
    url = env("GCLOUD_HOSTED_LOGS_URL")
    basic_auth {
      username = env("GCLOUD_HOSTED_LOGS_ID")
      password = env("GCLOUD_RW_API_KEY")
    }
  }
}

// The daily OSM refresh logs to the host journal rather than to a container, and every stack on the
// box runs this same config off the same journal. JOURNAL_UNIT is set on one stack only; anywhere
// else it is empty and the match names a unit that exists nowhere, so the stream is shipped once.
// The unit runs once a day and logs per step, so no relabelling is needed to keep it bounded: both
// labels below are constant, and journal metadata is dropped without a relabel rule to promote it.
loki.source.journal "osm" {
  path       = "/var/log/journal"
  matches    = "_SYSTEMD_UNIT=" + coalesce(env("JOURNAL_UNIT"), "unset.service")
  labels     = { job = "systemd-journal", service = "osm-update" }
  forward_to = [loki.write.default.receiver]
}
