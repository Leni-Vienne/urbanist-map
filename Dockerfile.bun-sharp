# AI : Custom Bun Alpine image with libvips for Sharp image processing
# AI : This solves the Sharp native bindings issue on Alpine Linux (musl)
# AI : Build once on server, reuse for all deployments
FROM oven/bun:1.3.9-alpine

# AI : Install libvips for Sharp, create uploads dir, set ownership for bun user
# AI : Use vips (runtime only) instead of vips-dev (dev headers not needed since sharp ships pre-built binaries)
RUN apk add --no-cache libstdc++ vips \
    && mkdir -p /app/uploads \
    && chown -R bun:bun /app

# AI : Set WORKDIR before switching user
WORKDIR /app

# AI : Run as non-root user for security
USER bun

# AI : Ensure HOME is set so bun uses /home/bun/.bun cache instead of /root/.bun
# AI : Also set BUN_INSTALL_CACHE_DIR explicitly to avoid any ambiguity
ENV HOME=/home/bun
ENV BUN_INSTALL_CACHE_DIR=/home/bun/.bun/install/cache

# AI : Pre-install sharp to cache it in the image (avoids runtime internet dependency)
# AI : Running as bun user ensures the cache is in /home/bun/.bun, not /root/.bun
# AI : Clean bun install cache after install to avoid bloating the image layer
RUN bun add sharp \
    && rm -rf "${BUN_INSTALL_CACHE_DIR}"

LABEL description="Bun 1.3 Alpine with libvips and baked-in Sharp"
LABEL maintainer="urbanistmap.org"
